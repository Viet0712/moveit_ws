<launch>
    <let name="urdf_path" value="$(find-pkg-share my_robot_description)/urdf/my_robot.urdf.xacro"/>
    <let name="rviz_config_path" value="$(find-pkg-share my_robot_bringup)/config/my_robot_moveit.rviz"/>

    <arg name="use_mock_component" default="true" />

    <node pkg="robot_state_publisher" exec="robot_state_publisher" output="screen">
        <param name="robot_description" value="$(command 'xacro $(var urdf_path) use_mock_component:=$(var use_mock_component)')" />
    </node>

    <node pkg="controller_manager" exec="ros2_control_node" output="screen">
        <param from="$(find-pkg-share my_robot_bringup)/config/ros2_controllers.yaml" />
        <!-- ubuntu 22 -->
        <!-- <remap from="~/robot_description" to="/robot_description" /> -->
    </node>

    <node pkg="controller_manager" exec="spawner" args="joint_state_broadcaster --controller-manager /controller_manager" output="screen" />

    <node pkg="controller_manager" exec="spawner" args="arm_controller --controller-manager /controller_manager" output="screen" />

    <node pkg="controller_manager" exec="spawner" args="gripper_controller --controller-manager /controller_manager" output="screen" />

    <include file="$(find-pkg-share my_robot_moveit_config)/launch/move_group.launch.py" />

    <node pkg="rviz2" exec="rviz2" output="screen" args="-d $(var rviz_config_path)" />
</launch>